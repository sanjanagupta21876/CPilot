# ==============================================================================
# CityPilot Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit .env.local to version control.
# ==============================================================================

# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini AI Provider (Optional: for background research synthesis)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Phase 3: Prune AI Gateway Narration (Optional, Server-only)
# Set NARRATION_ENABLED=true for live AI narration demos.
# Default is false (uses deterministic template fallback).
NARRATION_ENABLED=false
PRUNE_API_KEY=prune_your_api_key_here
PRUNE_MODEL=gpt-4o-mini
PRUNE_BASE_URL=https://api.withprune.com/v1
